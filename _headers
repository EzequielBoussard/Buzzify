# Los dos hash de la CSP cubren el script de arranque y el <style> del
# <noscript> de index.html. Si se editan, hay que recalcularlos: el comando
# esta en la seccion Despliegue del README.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-cq+u/NbnmMhOAKN5Sl8eR/7V3dZQDs4jBAyUZLyouAs='; style-src 'self' 'sha256-AcblDRRZwa/bl/uEVMS0Qliu7BOb1DfLAYglsh1mK3k='; img-src 'self'; font-src 'self'; media-src 'self' blob:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

/src/*
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/assets/og-image.png
  Cache-Control: public, max-age=604800

/assets/audio/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/fonts/*
  Cache-Control: public, max-age=604800

/assets/icons/*
  Cache-Control: public, max-age=604800
